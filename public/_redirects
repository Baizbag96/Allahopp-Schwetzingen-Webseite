# Netlify-Redirects: alte WordPress-URLs -> neue Seiten (Google-Rankings erhalten)
# Nach dem Deploy jede Zeile prüfen, z. B.:
#   curl -sI "https://<projekt>.netlify.app/?page_id=73"

# Schritt 1: ?page_id=… auf einen sauberen Pfad abbilden
# "!" erzwingt die Regel, obwohl unter "/" die index.html liegt (sonst ignoriert Netlify sie).
# Greift nur, wenn page_id gesetzt ist – die normale Startseite bleibt unberührt.
/  page_id=:id  /alte-seite/:id  301!

# Schritt 2: alte Seiten-IDs auf neue URLs
/alte-seite/73    /alla-hopp         301
/alte-seite/4606  /kindergeburtstag  301
/alte-seite/4611  /oeffnungszeiten   301
/alte-seite/312   /kontakt           301
/alte-seite/3     /datenschutz       301
# Unbekannte IDs: 404 statt Umleitung auf "/" – sonst Endlosschleife,
# weil Netlify ?page_id=… wieder an "/" anhängt
/alte-seite/*     /404.html          404

/privacy-policy   /datenschutz       301
/privacy-policy/  /datenschutz       301

# Speise- und Getränkekarte
/wp-content/uploads/2026/01/Tafel-alla-Hopp-Speisen_2025.pdf    /karten/speisen.pdf    301
/wp-content/uploads/2026/01/Karte-alla-hopp-Getraenke_2025.pdf  /karten/getraenke.pdf  301
/wp-content/uploads/2026/01/alla-hopp-Flyer_Geburtstag.pdf      /karten/geburtstag-flyer.pdf  301

# Restliche WordPress-Pfade
/wp-admin/*     /  301
/wp-content/*   /  301
/wp-login.php   /  301
